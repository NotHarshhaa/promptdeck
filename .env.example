# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# PromptDeck local persistence (optional; defaults to ./data/promptdeck.db)
PROMPTDECK_DB_PATH=./data/promptdeck.db

# Configure one or more providers to enable Live mode. Keys remain server-side.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Set this only when a local Ollama server is running, for example:
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=
